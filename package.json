{
  "name": "poprtp",
  "version": "2.0.0",
  "private": true,
  "description": "POP RTP — live RTP monitor (Express API + static site)",
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "build:articles": "node scripts/build-articles.js",
    "build": "npm run build:client && npm run build:articles",
    "export:static": "npm run build && node scripts/export-static.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "express": "^4.21.0",
    "gss-lang": "^0.0.6",
    "marked": "^15.0.0"
  }
}
