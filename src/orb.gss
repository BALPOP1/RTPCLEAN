/* Clean 3-second splash orb: ONE logo (POPJUN) on a single 3D ball with a gentle floating animation. */
@scene {
  group#ball {
    sphere#jun;
  }
  group#halo {
    torus#ring;
  }
  group#tilt {
    torus#ring2;
  }
  group#orbit {
    sphere.moon * 3;
  }
}

scene {
  floor: none;
  background: #000;
  camera-distance: 8;
  camera-angle: 0deg 6deg;
  dpr: auto;
  shadows: none;
  ambient: 0.72;
  shape-rendering: geometricPrecision;
  filter: bloom(0.18) saturate(1.12);
}

#jun {
  radius: 1.18;
  color: #f4f7fc;
  material: matte();
}

#jun::face(front) {
  texture: url("asset/orb/31.png");
}

#ball {
  animation: float 1.5s ease-in-out infinite alternate;
}

#ring {
  radius: 1.65;
  thickness: 0.045;
  color: rgb(249, 22, 22);
  material: emissive();
}

#halo {
  rotate-x: 72deg;
  animation: spin-z 6s linear infinite;
}

#ring2 {
  radius: 1.95;
  thickness: 0.025;
  color: #60a5fa;
  material: emissive();
}

#tilt {
  rotate-z: 58deg;
  animation: spin-x 9s linear infinite;
}

.moon {
  radius: 0.12;
  color: #fbbf24;
  material: emissive();
  translate: calc(cos(sibling-index() * 120deg) * 1.65) 0 calc(sin(sibling-index() * 120deg) * 1.65);
}

#orbit {
  rotate-x: 72deg;
  animation: spin-z 6s linear infinite;
}

@keyframes float {
  from { translate: 0 -0.14 0; rotate-y: -8deg; }
  to { translate: 0 0.14 0; rotate-y: 8deg; }
}

@keyframes spin-z {
  from { rotate-y: 0deg; }
  to { rotate-y: 360deg; }
}

@keyframes spin-x {
  from { rotate-y: 0deg; }
  to { rotate-y: 360deg; }
}
